# viktor-memory environment configuration template (ADR 0003)
# Copy this file to .env and fill in actual values, or export the vars
# before running `viktor memory sync`.
# DO NOT commit .env to git.

# Ollama: local embedding server. Reuse the same instance that repowise
# uses (see ~/tcu-book/.repowise/config.yaml -> embedder: ollama).
# Model must be pulled first: `ollama pull bge-m3`
VIKTOR_MEMORY_OLLAMA_URL=http://localhost:11434
VIKTOR_MEMORY_EMBED_MODEL=bge-m3

# Qdrant: local vector store for the viktor_tasks collection.
# Start once, e.g.: docker run -p 6333:6333 qdrant/qdrant
VIKTOR_MEMORY_QDRANT_URL=http://localhost:6333
VIKTOR_MEMORY_COLLECTION=viktor_tasks

# Optional per-instance git repo for commit enrichment
# (payload.commits via `git log --grep`).
# VIKTOR_MEMORY_GIT_REPO=/Users/mikhail/projects/my-mcp/viktor
