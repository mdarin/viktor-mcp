# viktor-memory environment configuration template (ADR 0003)
# Copy this file to .env and fill in actual values, or export the vars
# before running `viktor memory sync`.
# DO NOT commit .env to git.

# Ollama: local embedding server. Reuse the same instance that repowise
# uses (see ~/tcu-book/.repowise/config.yaml -> embedder: ollama).
# Model must be pulled first: `ollama pull bge-m3`
VIKTOR_MEMORY_OLLAMA_URL=http://localhost:11434
VIKTOR_MEMORY_EMBED_MODEL=bge-m3

# Qdrant: vector store for the viktor memory index (target instance —
# SSH-forward localhost:16333; use whatever endpoint your Qdrant runs on).
VIKTOR_MEMORY_QDRANT_URL=http://localhost:16333
# api-key required when the instance enforces one (target does).
VIKTOR_MEMORY_QDRANT_API_KEY=
VIKTOR_MEMORY_COLLECTION=viktor_tasks

# Optional per-instance git repo for commit enrichment
# (payload.commits via `git log --grep`).
# VIKTOR_MEMORY_GIT_REPO=/Users/mikhail/projects/my-mcp/viktor

# --- Reflection journal (card #853) ---
# Canonical storage: PostgreSQL hosting viktor.reflections (the server
# auto-creates the schema and table on first use; it never touches
# Vikunja tables). Without a DSN reflection_log / reflection_list answer
# {supported:false}. The vector index mirrors the journal via
# `viktor memory sync` (chunk_type=reflection).
# VIKTOR_REFLECTION_PG_DSN=postgres://viktor:PASSWORD@localhost:15432/viktor
# VIKTOR_REFLECTION_REPO=viktor

# --- Lexical history search (search_history, card #867) ---
# ParadeDB/PostgreSQL DSN hosting the `search_history` table fed by
# `viktor history sync` (task titles/descriptions + comments, BM25).
# Without a DSN search_history answers {supported:false}.
# VIKTOR_HISTORY_PG_DSN=postgres://viktor:PASSWORD@localhost:15432/viktor

# --- Dev-стенд (make dev-up, docker-compose.dev.yml) ---
# Все сервисы стенда слушают верхние порты, чтобы не конфликтовать
# с боевыми инстансами (Vikunja 13456, Qdrant 6333, Ollama 11434).
# Для memory sync против стенда:
# VIKTOR_MEMORY_OLLAMA_URL=http://localhost:11435
# VIKTOR_MEMORY_QDRANT_URL=http://localhost:16333
# ParadeDB (search_history, БД viktor/viktor): localhost:15433
# Vikunja стенда: http://localhost:13457

# --- Bot identity (card #616) ---
# Инлайн-комментарии после значения допустимы (парсер dotenv их срезает).
# VIKTOR_BOT_NAME / VIKTOR_BOT_TOKEN (алиасы VIKUNJA_BOT_*) регистрируют
# bot-токен на default-инстансе (config: Instance.Agents). Создание бота и
# минт токена — только по JWT-сессии владельца (upstream исключает
# user_*/tokens из API-токен-авторизации), поэтому токен минтится заранее.
# Без VIKUNJA_AGENT сервер действует под ботом; с VIKUNJA_AGENT=<имя> —
# под указанной идентичностью (fallback — операторский VIKUNJA_TOKEN).
# VIKTOR_BOT_NAME=bot-viktor-mcp
# VIKTOR_BOT_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VIKUNJA_AGENT=crewai-agent
